<!DOCTYPE html>
<html lang="{{ session.language }}">
<head>
<meta charset="utf-8" />
<style>
  @page { size: A4; margin: 18mm 16mm; }
  body { font-family: "Noto Sans", "DejaVu Sans", sans-serif; color: #111827; font-size: 10.5pt; }
  h1 { font-size: 20pt; margin: 0 0 2pt; }
  h2 { font-size: 13pt; margin: 16pt 0 6pt; border-bottom: 1px solid #d1d5db; padding-bottom: 3pt; }
  table { width: 100%; border-collapse: collapse; margin: 6pt 0; }
  th, td { border: 1px solid #e5e7eb; padding: 4pt 6pt; text-align: left; }
  th { background: #f3f4f6; }
  .meta { color: #6b7280; font-size: 9pt; }
</style>
</head>
<body>
  <h1>{{ t('pdf.agenda_title') }} — {{ booking.title or session.id }}</h1>
  <div class="meta">
    {% if booking.iso %}Start: {{ booking.iso }}{% endif %}
    {% if booking.duration_min %} · {{ booking.duration_min }} min{% endif %}
    {% if booking.room %} · {{ booking.room }}{% endif %}
  </div>

  {% if next_agenda %}
  <h2>{{ t('pdf.agenda_title') }}</h2>
  <table>
    <tr><th>#</th><th>Item</th><th>Time</th></tr>
    {% for it in next_agenda %}<tr><td>{{ loop.index }}</td><td>{{ it.title }}</td><td>{{ it.timebox_minutes or '' }}</td></tr>{% endfor %}
  </table>
  {% endif %}

  {% if required %}
  <h2>{{ t('pdf.present') }}</h2>
  <ul>{% for a in required %}<li>{{ a.display_name }}{% if a.required_reason %} — {{ a.required_reason }}{% endif %}</li>{% endfor %}</ul>
  {% endif %}

  {% if open_actions %}
  <h2>{{ t('pdf.open_actions') }}</h2>
  <table>
    <tr><th>Ref</th><th>Action</th><th>{{ t('pdf.owner') }}</th><th>{{ t('pdf.due') }}</th></tr>
    {% for a in open_actions %}<tr><td>{{ a.ref }}</td><td>{{ a.title }}</td><td>{{ a.owner_name or '—' }}</td><td>{{ a.due_date or '—' }}</td></tr>{% endfor %}
  </table>
  {% endif %}
</body>
</html>
