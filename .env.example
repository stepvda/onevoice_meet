# --- LiveKit ---
# Generate with: docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=APIchangeme
LIVEKIT_API_SECRET=changeme-64-char-random
LIVEKIT_WS_URL=wss://meet.witysk.org/rtc

# Webhook key (use same value as LIVEKIT_API_KEY unless you want per-webhook keys)
LIVEKIT_WEBHOOK_KEY=APIchangeme

# Public IP of the host (set explicitly for reliability behind NAT)
LIVEKIT_EXTERNAL_IP=203.0.113.10

# --- meeting-api ---
MEETING_API_PORT=8080
DATABASE_URL=sqlite:////var/lib/meet/meet.db
RECORDINGS_DIR=/var/lib/meet/recordings
# Where playlist MP4s are stored, as <PLAYBACK_DIR>/<meeting_id>/<item_id>.mp4.
# Must be bind-mounted into meeting-api at this same absolute path, because
# playback_items.file_path stores absolute paths. Production points this at a
# dedicated volume: /mnt/video1/meetvideos
PLAYBACK_DIR=/var/lib/meet/playback
RECORDING_RETENTION_DAYS=30

# --- JWT / auth bridge ---
# HS256 shared secret — MUST match one.witysk.org's SECRET_KEY so tokens are valid across both.
JWT_SECRET_KEY=set-to-same-value-as-one-witysk-secret-key
JWT_ALGORITHM=HS256
JWT_AUDIENCE=meet.witysk.org

# Reserved for future DPoP/JWKS migration (currently unused):
# ONE_WITYSK_JWKS_URL=https://one.witysk.org/.well-known/jwks.json
# ONE_WITYSK_ISSUER=https://one.witysk.org
# DPOP_REPLAY_TTL_SECONDS=300

# --- coturn reuse (short-lived TURN creds per RFC 5766) ---
TURN_HOST=turn.witysk.org
TURN_STATIC_AUTH_SECRET=set-to-same-value-as-coturn-static-auth-secret
TURN_TTL_SECONDS=3600

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Rate limiting ---
ANON_TOKEN_RATE_PER_HOUR=30

# --- Frontend ---
# URL users visit; used for CORS and generated join links
PUBLIC_URL=https://meet.witysk.org

# ─── Meet++ (AI meeting organiser) ─────────────────────────────────────────
# Global kill switch. Start with false, enable after the smoke test.
MEETPP_ENABLED=false
# JSON list of owner subs allowed to use Meet++ (empty = all eligible owners).
MEETPP_PILOT_OWNER_SUBS=[]
# Concurrent CPU-STT sessions the host can sustain (1 on the 4-vCPU host).
MEETPP_MAX_ACTIVE_SESSIONS=1
# HMAC secret shared with meetpp-agent. Generate with: openssl rand -hex 32
MEETPP_INTERNAL_SECRET=
MEETPP_AGENT_URL=http://meetpp-agent:8091
MEETPP_DATA_DIR=/var/lib/meet/meetpp
MEETPP_LANGUAGES=["en"]
MEETPP_DEFAULT_MODE=lead

# LLM gateway (OpenAI-compatible chat completions). Leave empty for
# captions-only mode. Distinct from DEEPSEEK_API_KEY used by the offline
# translation scripts.
# Production uses the association's own model through the OneVoice AI gateway
# (meeting content stays on its own server); DeepSeek remains possible.
LLM_BASE_URL=https://one.witysk.org/ai/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-35b-a3b
LLM_MODEL_FINAL=qwen3.6-35b-a3b
LLM_PROVIDER_LABEL=OneVoice AI (local model qwen3.6-35b-a3b, on the association's own server)
# A local model writes long minutes more slowly (~100 tokens/s): allow 150 s.
LLM_TIMEOUT_SECONDS=150
# DeepSeek instead: LLM_BASE_URL=https://api.deepseek.com, LLM_MODEL=deepseek-chat,
# LLM_PROVIDER_LABEL=DeepSeek API (outside the EU)

# Meet++ v3 (FDD v3.1) tuning.
MEETPP_TICK_SECONDS=12
MEETPP_CONTEXT_SECONDS=90
MEETPP_MAX_TOKENS_PER_HOUR=3000000
# Per-utterance audio is deleted at publish; unpublished sessions after N days.
MEETPP_AUDIO_RETENTION_DAYS=7
MEETPP_TTS_VOICE=am_michael

# Tier 1 (live) STT in meetpp-agent: faster-whisper, English forced.
STT_MODEL=small
STT_DEGRADE_MODEL=base
STT_THREADS=2
STT_COMPUTE_TYPE=int8

# Tier 2 on the Mac Studio (meetpp-speech: large-v3-turbo + Kokoro TTS),
# reached over WireGuard. Empty URL = tier 1 only.
MEETPP_SPEECH_URL=http://10.88.0.2:9310
# Shared with meetpp-speech (~/.config/meetpp-speech/env). openssl rand -hex 32
MEETPP_SPEECH_SECRET=
